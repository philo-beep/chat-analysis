# 本地推理，不需要任何云端 API Key。复制为 backend/.env。
# 留空/未设置时使用随项目附带的 NB 模型，不修改桌面 ai_followup_trainer。
# FOLLOWUP_MODEL_PATH=C:/path/to/char_ngram_nb.json
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_TIMEOUT=600
API_BASE=http://127.0.0.1:8000

# 可选：JWT 签名密钥至少32字符。留空请不要设置此变量，服务会安全生成到
# 当前用户 ~/.codex/local-credentials/keyoushu-jwt.key（不在仓库内）。
# KEYOUSHU_JWT_SECRET=replace-with-a-long-random-secret
