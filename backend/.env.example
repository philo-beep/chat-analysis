# 云端 OpenAI 兼容模型配置。复制为 backend/.env 后填写密钥。
FOLLOWUP_API_KEY=
FOLLOWUP_BASE_URL=https://api.openai-next.com
FOLLOWUP_MODEL=gpt-6.1-sol
FOLLOWUP_REASONING_EFFORT=medium
FOLLOWUP_TIMEOUT=180
FOLLOWUP_MAX_TOKENS=8192
FOLLOWUP_QUALITY_REVIEW=true
API_BASE=http://127.0.0.1:8000

# 可选：JWT 签名密钥至少32字符。留空请不要设置此变量，服务会安全生成到
# 当前用户 ~/.codex/local-credentials/keyoushu-jwt.key（不在仓库内）。
# KEYOUSHU_JWT_SECRET=replace-with-a-long-random-secret
